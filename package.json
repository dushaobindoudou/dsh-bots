{
  "name": "dsh-bots",
  "version": "0.2.69",
  "description": "Bots for DeepSeek Harness: create AI bots and group chats in the dsh web sidebar, with skills, tools and per-bot models.",
  "icon": "./icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "skills",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && node scripts/bake-version.mjs",
    "prepare": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:browser": "node scripts/browser-test.mjs",
    "test:integration": "node scripts/integration-test.mjs",
    "test:dsh-smoke": "bash scripts/dsh-smoke.sh",
    "test:finance": "python3 -m unittest discover -s tests/finance -p \"test_*.py\""
  },
  "keywords": [
    "bots",
    "cordis",
    "deepseek-harness",
    "dsh-plugin",
    "dsh-plugins",
    "group-chat",
    "mcp",
    "multibot",
    "workbench"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.5-rc.2 || ^0.2.0-rc.2",
    "multibot-sdk": "^0.6.0"
  },
  "peerDependenciesMeta": {
    "multibot-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.5-rc.2",
    "@types/node": "^24.13.6",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/dushaobindoudou/dsh-bots.git"
  },
  "homepage": "https://github.com/dushaobindoudou/dsh-bots#readme",
  "bugs": {
    "url": "https://github.com/dushaobindoudou/dsh-bots/issues"
  }
}
